# ==============================================================================
# StudyFlow AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), set these in the project environment variables settings.
# ==============================================================================

# Anthropic Claude API Key (Required for AI generation)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Selected Claude Model (Default: claude-3-5-sonnet-20241022 or claude-3-haiku-20240307)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Rate limiting settings (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# Next.js Environment
NODE_ENV=development

